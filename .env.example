# --- База данных -------------------------------------------------------------
# Локально: файл SQLite (создаётся автоматически при первом запуске).
# В продакшене (Vercel): Turso / libSQL — укажите URL и токен.
DATABASE_URL=file:./data/bailanysta.db
# Интеграция Turso в Vercel задаёт эти две переменные сама (DATABASE_URL тогда не нужен):
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=

# --- Сессии ------------------------------------------------------------------
# Любая длинная случайная строка. В проде обязательно замените.
SESSION_SECRET=change-me-please-32-chars-minimum

# --- Искусственный интеллект («Муза») ----------------------------------------
# Ключ Anthropic. Без него Муза работает в офлайн-режиме (локальные шаблоны).
# ANTHROPIC_API_KEY=sk-ant-...

# --- Звонки: TURN-релей для WebRTC (иначе устройства в разных сетях могут не соединиться) ---
# Вариант 1 — Cloudflare Calls TURN (бесплатно до 1 ТБ/мес): dash.cloudflare.com → Calls → TURN → Create
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Вариант 2 — Metered.ca (есть бесплатный план): dashboard.metered.ca → TURN → API key
# METERED_DOMAIN=myapp.metered.live
# METERED_API_KEY=
# Вариант 3 — свой coturn или любой TURN
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Вход по коду (OTP) ---------------------------------------------------------
# Почта, вариант 1 — любой SMTP (например Gmail с паролем приложения: smtp.gmail.com, порт 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=пароль приложения (16 символов)
# MAIL_FROM=Expert Bailanysta <you@gmail.com>
# Почта, вариант 2 — Resend (бесплатный план). MAIL_FROM — адрес с подтверждённого домена;
# для тестов подойдёт onboarding@resend.dev (письма только на почту владельца аккаунта Resend).
# RESEND_API_KEY=
# MAIL_FROM=Expert Bailanysta <noreply@yourdomain.kz>
# SMS — Twilio.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX
# Без этих ключей код показывается на экране (демо-режим) — удобно для проверки, не для продакшена.

# --- Администраторы -----------------------------------------------------------
# Почты (через запятую), которым автоматически даётся доступ к /admin. Роль можно выдать и в самой панели.
# ADMIN_EMAILS=you@example.com

# Поиск GIF в чатах (Tenor v2, бесплатный ключ в Google Cloud Console → Tenor API). Без ключа пикер GIF показывает подсказку, GIF-файлы можно прикреплять всегда.
TENOR_API_KEY=
