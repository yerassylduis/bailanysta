# --- База данных -------------------------------------------------------------
# Локально: файл SQLite (создаётся автоматически при первом запуске).
# В продакшене (Vercel): Turso / libSQL — укажите URL и токен.
DATABASE_URL=file:./data/bailanysta.db
# TURSO_AUTH_TOKEN=

# --- Сессии ------------------------------------------------------------------
# Любая длинная случайная строка. В проде обязательно замените.
SESSION_SECRET=change-me-please-32-chars-minimum

# --- Искусственный интеллект («Муза») ----------------------------------------
# Ключ Anthropic. Без него Муза работает в офлайн-режиме (локальные шаблоны).
# ANTHROPIC_API_KEY=sk-ant-...
