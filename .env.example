# --- База данных -------------------------------------------------------------
# Локально: файл SQLite (создаётся автоматически при первом запуске).
# В продакшене (Vercel): Turso / libSQL — укажите URL и токен.
DATABASE_URL=file:./data/bailanysta.db
# Интеграция Turso в Vercel задаёт эти две переменные сама (DATABASE_URL тогда не нужен):
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=

# --- Сессии ------------------------------------------------------------------
# Любая длинная случайная строка. В проде обязательно замените.
SESSION_SECRET=change-me-please-32-chars-minimum

# --- Искусственный интеллект («Муза») ----------------------------------------
# Ключ Anthropic. Без него Муза работает в офлайн-режиме (локальные шаблоны).
# ANTHROPIC_API_KEY=sk-ant-...

# --- Звонки: TURN-релей для WebRTC (иначе устройства в разных сетях могут не соединиться) ---
# Вариант 1 — Cloudflare Calls TURN (бесплатно до 1 ТБ/мес): dash.cloudflare.com → Calls → TURN → Create
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# Вариант 2 — Metered.ca (есть бесплатный план): dashboard.metered.ca → TURN → API key
# METERED_DOMAIN=myapp.metered.live
# METERED_API_KEY=
# Вариант 3 — свой coturn или любой TURN
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
